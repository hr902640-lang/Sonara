DATABASE_URL="postgresql://sonora:change-me@localhost:5432/sonora"
# demo uses bundled fixtures. live reads only successfully synchronized provider data.
SONORA_DATA_MODE="demo"
TREND_REFRESH_MINUTES=15
# Protect POST /api/sync when invoking it from a scheduler.
CRON_SECRET="replace-with-a-long-random-value"
# Provider credentials stay server-side. Add only official, permitted integrations.
YOUTUBE_API_KEY=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
APPLE_MUSIC_KEY=""
